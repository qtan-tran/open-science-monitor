{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Issue (weekly briefing dataset)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "week_start",
    "generated_at",
    "status",
    "summary",
    "signal",
    "headline_event",
    "items",
    "counts",
    "paths"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "week_start": { "type": "string", "format": "date" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["sample", "draft", "published"] },
    "summary": { "type": "string", "minLength": 10 },
    "signal": { "type": "string" },
    "headline_event": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "items": { "type": "string", "pattern": "^evt-[a-z0-9][a-z0-9-]*$" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": { "type": "integer", "minimum": 0 },
        "candidates": { "type": "integer", "minimum": 0 },
        "sources_checked": { "type": "integer", "minimum": 0 },
        "sources_failed": { "type": "integer", "minimum": 0 }
      }
    },
    "run_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cutoff", "horizon_from", "sources_checked", "sources_failed", "failures", "sources", "notes", "llm_assisted"],
      "properties": {
        "cutoff": { "type": "string", "format": "date-time" },
        "horizon_from": { "type": ["string", "null"] },
        "sources_checked": { "type": "integer", "minimum": 0 },
        "sources_failed": { "type": "integer", "minimum": 0 },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "error"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "error": { "type": "string" }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "ok"],
            "properties": {
              "id": { "type": "string" },
              "ok": { "type": "boolean" },
              "new_candidates": { "type": "integer" },
              "error": { "type": "string" }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "not_shortlisted": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "reason"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "llm_assisted": { "type": "boolean" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markdown", "html", "substack"],
      "properties": {
        "markdown": { "type": "string", "pattern": "^issues/\\d{4}-W\\d{2}/index\\.md$" },
        "html": { "type": "string", "pattern": "^issues/\\d{4}-W\\d{2}/index\\.html$" },
        "substack": { "type": "string", "pattern": "^issues/\\d{4}-W\\d{2}/substack\\.md$" }
      }
    },
    "sample": { "type": "boolean" }
  }
}
