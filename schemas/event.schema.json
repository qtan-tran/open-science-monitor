{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event (single OA/OS development record)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "organization",
    "org_type",
    "region",
    "topics",
    "doc_type",
    "status",
    "policy_id",
    "dates",
    "sources",
    "what_changed",
    "why_it_matters",
    "editorial_status",
    "appearances",
    "verified"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^evt-[a-z0-9][a-z0-9-]*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 8 },
    "organization": { "type": "string", "minLength": 2 },
    "org_type": { "type": "string", "minLength": 2 },
    "region": {
      "enum": ["Europe", "North America", "Latin America & Caribbean", "Africa", "Asia Pacific", "Global"]
    },
    "country": { "type": ["string", "null"] },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "oa-policy",
          "funder-mandates",
          "consultations",
          "diamond-oa",
          "apc-bpc",
          "transformative-agreements",
          "business-models",
          "repositories",
          "rights-retention",
          "licensing",
          "research-data",
          "research-assessment",
          "equity",
          "multilingualism",
          "indigenous-data",
          "infrastructure",
          "research-evidence"
        ]
      }
    },
    "doc_type": {
      "enum": ["policy", "guidance", "consultation", "report", "study", "analysis", "position", "announcement", "materials"]
    },
    "status": { "enum": ["new", "updated"] },
    "policy_id": { "type": ["string", "null"], "pattern": "^(pol-[a-z0-9][a-z0-9-]*|null)$" },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published", "updated", "effective", "consultation_deadline", "discovered"],
      "properties": {
        "published": { "type": ["string", "null"], "format": "date" },
        "updated": { "type": ["string", "null"], "format": "date" },
        "effective": { "type": ["string", "null"], "format": "date" },
        "consultation_deadline": { "type": ["string", "null"], "format": "date" },
        "discovered": { "type": "string", "format": "date" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url", "kind"],
        "properties": {
          "label": { "type": "string", "minLength": 3 },
          "url": { "type": "string", "format": "uri" },
          "source_id": { "type": "string" },
          "kind": { "enum": ["primary", "secondary"] }
        }
      }
    },
    "what_changed": { "type": "string", "minLength": 40 },
    "why_it_matters": { "type": "string", "minLength": 40 },
    "editorial_status": { "enum": ["pending", "edited"] },
    "supersedes": { "type": ["string", "null"] },
    "merged_from": { "type": "array", "items": { "type": "string" } },
    "appearances": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" } },
    "verified": { "type": "boolean" },
    "sample": { "type": "boolean" },
    "llm_suggestions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "model": { "type": "string" },
        "topics": { "type": "array", "items": { "type": "string" } },
        "what_changed": { "type": "string" },
        "why_it_matters": { "type": "string" }
      }
    },
    "note": { "type": ["string", "null"] }
  }
}
