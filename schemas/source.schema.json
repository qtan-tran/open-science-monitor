{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "config/sources.yml (parsed form)",
  "type": "object",
  "additionalProperties": false,
  "required": ["coverage", "sources"],
  "properties": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "gaps", "as_of", "how_to_add"],
      "properties": {
        "scope": { "type": "string", "minLength": 20 },
        "gaps": { "type": "array", "items": { "type": "string" } },
        "as_of": { "type": "string", "format": "date" },
        "how_to_add": { "type": "string" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "url", "kind", "region", "language", "method", "enabled", "priority", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "url": { "type": "string", "format": "uri" },
          "kind": { "type": "string" },
          "region": {
            "enum": ["Europe", "North America", "Latin America & Caribbean", "Africa", "Asia Pacific", "Global"]
          },
          "language": { "type": "string", "minLength": 2 },
          "method": { "enum": ["rss", "atom", "page"] },
          "feed": { "type": "string", "format": "uri" },
          "enabled": { "type": "boolean" },
          "priority": { "enum": ["core", "supplementary"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
