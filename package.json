{
  "name": "open-science-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Open Science Monitor: an Open Access / Open Science policy monitor with a weekly briefing pipeline and a static research-publication website.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "validate": "node scripts/pipeline/validate-data.ts",
    "check-sources": "node scripts/check-sources.ts",
    "issue": "node scripts/run-issue.ts",
    "build": "node scripts/build-site.ts",
    "preview": "node scripts/serve-dist.ts",
    "render": "node scripts/render-issue-outputs.ts"
  }
}
